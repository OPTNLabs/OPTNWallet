// Regenerates test-vectors/psbt-ur.json, the oracle for the Rust PSBT UR
// encoder (crates/optn-core/src/ur.rs).
//   npx tsx scripts/generate-psbt-ur-vectors.mts
//
// The frames come from @ngraveio/bc-ur, an independent implementation of the
// Blockchain Commons fountain encoder, never from the wallet's own encoder:
// a vector the code under test wrote would only prove it agrees with itself.
// Each case runs past the pure fragments into mixed ones, so the Xoshiro256**
// seed, the degree sampler and the shuffle are pinned too, not just the
// partition. The UR CBOR field is the raw PSBT, which is what SeedCash emits
// and parses.
import { writeFileSync } from 'node:fs';
import { UR, UREncoder } from '@ngraveio/bc-ur';

/** A PSBT-shaped payload: the magic, then a fixed pattern. */
function payload(size: number): Uint8Array {
  const bytes = new Uint8Array(size);
  bytes.set([0x70, 0x73, 0x62, 0x74, 0xff]);
  for (let index = 5; index < size; index += 1) {
    bytes[index] = (index * 31 + 7) & 0xff;
  }
  return bytes;
}

const cases = [
  { size: 30, fragmentLength: 50, why: 'fits one fragment: a single-part UR' },
  { size: 50, fragmentLength: 50, why: 'exactly one fragment' },
  { size: 51, fragmentLength: 50, why: 'one byte over: two fragments' },
  { size: 300, fragmentLength: 50, why: 'an ordinary watch-only send' },
  { size: 1_200, fragmentLength: 50, why: 'a large send at the default' },
  {
    size: 2_400,
    fragmentLength: 50,
    why: 'the size phones used to show as one dense static QR',
  },
  { size: 1_200, fragmentLength: 100, why: 'denser frames' },
  { size: 2_400, fragmentLength: 450, why: 'the densest frame offered' },
  { size: 9, fragmentLength: 10, why: 'the minimum fragment length' },
];

const vectors = cases.map(({ size, fragmentLength, why }) => {
  const message = payload(size);
  const encoder = new UREncoder(
    new UR(Buffer.from(message), 'crypto-psbt'),
    fragmentLength
  );
  const frameCount = encoder.fragmentsLength;
  // Two full passes plus a few: every pure fragment and enough mixed ones to
  // exercise degree choice across the range.
  const frames = Array.from({ length: frameCount * 2 + 3 }, () =>
    encoder.nextPart().toUpperCase()
  );
  return {
    description: `${size} bytes at fragment length ${fragmentLength}: ${why}`,
    psbtHex: Buffer.from(message).toString('hex'),
    maxFragmentLength: fragmentLength,
    frameCount,
    frames,
  };
});

const document = {
  $comment:
    'Generated by scripts/generate-psbt-ur-vectors.mts from @ngraveio/bc-ur. ' +
    'Frames are numbered from 1; frames[i] is sequence number i + 1. ' +
    'Regenerate only on purpose: every air-gapped signer reads these bytes.',
  urType: 'crypto-psbt',
  vectors,
};

const path = 'test-vectors/psbt-ur.json';
writeFileSync(path, `${JSON.stringify(document, null, 2)}\n`, 'utf8');
console.log(`wrote ${vectors.length} vectors to ${path}`);
