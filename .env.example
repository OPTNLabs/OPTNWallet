# Development-only values. Never put recovery phrases, private keys, or release
# credentials in this file or in .env committed to source.

# Optional web/Android build configuration. Leave blank when not required.
VITE_API_URL=

# Development-only private-key reveal. Keep false for release builds.
VITE_ENABLE_PRIVATE_KEY_VIEW=false

# Android release signing is supplied by the protected CI environment, not by
# local source control. Local release builds are unsigned unless configured.
KEYSTORE_PATH=
KEYSTORE_PASS=
KEYSTORE_ALIAS=
KEYSTORE_ALIAS_PASS=
