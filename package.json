{
  "name": "optn-wallet",
  "private": true,
  "version": "1.7.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "test": "vitest run",
    "test:core": "vitest run --exclude 'src/pages/apps/**'",
    "test:watch": "vitest",
    "test:cauldron:live": "RUN_CAULDRON_LIVE=1 vitest run src/services/__tests__/cauldron.live.test.ts",
    "test:cauldron:snapshot": "vitest run src/services/__tests__/cauldron.snapshot.test.ts src/pages/apps/cauldron/__tests__/quoteSafety.test.ts",
    "cauldron:snapshot:generate": "tsx scripts/generate-cauldron-snapshot.mts",
    "addons:validate": "vitest run src/services/addons/__tests__/BuiltinManifestValidation.test.ts",
    "cashscript:compile": "tsx scripts/compile-cashscript-artifacts.mts",
    "test:tooling": "vitest run scripts/__tests__",
    "typecheck": "tsc -b",
    "typecheck:core": "tsc -p tsconfig.core.json --noEmit",
    "build": "npm run typecheck:core && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:core": "eslint src --ext ts,tsx --ignore-pattern \"src/pages/apps/**\" --report-unused-disable-directives --max-warnings 0",
    "ci:core": "npm run lint:core && npm run typecheck:core && npm run test:core && npm run build",
    "security:audit": "npm audit --omit=dev --audit-level=critical",
    "security:audit:all": "npm audit --audit-level=high",
    "security:test": "vitest run src/utils/__tests__/secureMemory.test.ts src/redux/walletconnect/__tests__/helpers.security.test.ts",
    "security:ci": "npm run security:audit && npm run security:test",
    "preview": "vite preview",
    "postinstall": "patch-package",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css,scss,md}\" \"scripts/**/*.{ts,mts}\" \"*.config.ts\"",
    "tauri:dev": "tsx scripts/fetch-tor.mts && cross-env CARGO_TARGET_DIR=target tsx scripts/run-tauri.mts dev",
    "tauri:build": "tsx scripts/fetch-tor.mts && cross-env CARGO_TARGET_DIR=target tsx scripts/run-tauri.mts build",
    "build:web": "vite build",
    "build:extension:chrome": "cross-env EXTENSION_TARGET=chrome vite build --config vite.extension.config.ts",
    "build:extension:firefox": "cross-env EXTENSION_TARGET=firefox vite build --config vite.extension.config.ts",
    "test:e2e": "wdio run ./e2e/wdio.conf.ts",
    "capacitor:init": "npx cap init",
    "capacitor:add:android": "npx cap add android",
    "capacitor:add:ios": "npx cap add ios",
    "capacitor:copy": "npx cap copy",
    "capacitor:sync": "npx cap sync",
    "capacitor:sync:android": "npx cap sync android",
    "capacitor:sync:ios": "npx cap sync ios",
    "capacitor:open:android": "npx cap open android",
    "capacitor:open:ios": "npx cap open ios",
    "serve": "npx serve -s dist",
    "android:prepare": "dotenv -e .env -- npm run build:web && npm run capacitor:sync:android",
    "android:apk:dev": "VITE_ENABLE_PRIVATE_KEY_VIEW=true npm run android:prepare && cd android && ./gradlew assembleDebug",
    "android:apk:dev:install": "npm run android:apk:dev && adb install -r android/app/build/outputs/apk/debug/app-debug.apk",
    "android:apk:prod": "dotenv -e .env -- bash -lc 'npm run android:prepare && cd android && ./gradlew assembleRelease'",
    "android:aab:prod": "dotenv -e .env -- bash -lc 'npm run android:prepare && cd android && ./gradlew bundleRelease'",
    "build:aab": "npm run android:aab:prod",
    "build:apk": "npm run android:apk:prod"
  },
  "dependencies": {
    "@bitauth/libauth": "3.1.0-next.8",
    "@capacitor/android": "^7.0.0",
    "@capacitor/barcode-scanner": "^2.0.3",
    "@capacitor/camera": "^7.0.0",
    "@capacitor/clipboard": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/dialog": "^7.0.0",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/local-notifications": "^7.0.2",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.3",
    "@capacitor/toast": "^7.0.0",
    "@cashscript/utils": "0.13.0-next.3",
    "@choochmeque/tauri-plugin-biometry-api": "0.2.6",
    "@electrum-cash/network": "^4.1.3",
    "@electrum-cash/web-socket": "^1.0.0",
    "@keystonehq/animated-qr": "^0.10.0",
    "@keystonehq/bc-ur-registry": "^0.8.0",
    "@keystonehq/bc-ur-registry-btc": "^0.1.1",
    "@keystonehq/sdk": "^0.22.1",
    "@ledgerhq/hw-app-btc": "^11.2.1",
    "@ledgerhq/hw-transport-web-ble": "^6.35.0",
    "@ledgerhq/hw-transport-webhid": "^6.36.0",
    "@onekeyfe/hd-web-sdk": "^1.1.29",
    "@reduxjs/toolkit": "^2.2.5",
    "@reown/walletkit": "^1.5.5",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-http": "^2.5.2",
    "@tauri-apps/plugin-log": "^2.8.0",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@trezor/connect-web": "^9.7.3",
    "@types/sql.js": "^1.4.9",
    "@walletconnect/core": "^2.23.9",
    "@walletconnect/modal": "^2.7.0",
    "@walletconnect/sign-client": "^2.23.9",
    "@walletconnect/utils": "^2.23.9",
    "@wizardconnect/core": "^0.1.6",
    "@wizardconnect/wallet": "^0.1.5",
    "axios": "^1.18.0",
    "bip39": "^3.1.0",
    "buffer": "^6.0.3",
    "cashc": "0.13.0-next.3",
    "cashscript": "0.13.0-next.3",
    "decimal.js": "^10.4.3",
    "delay": "^6.0.0",
    "dotenv": "^16.4.7",
    "ecpair": "^3.0.1",
    "idb-keyval": "^6.2.1",
    "localforage": "^1.10.0",
    "luxon": "^3.6.1",
    "nostr-tools": "^2.23.12",
    "path": "^0.12.7",
    "qrcode.react": "^4.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-draggable": "^4.5.0",
    "react-icons": "^5.4.0",
    "react-loader-spinner": "^8.0.2",
    "react-multi-carousel": "^2.8.5",
    "react-redux": "^9.1.2",
    "react-router-dom": "^6.30.4",
    "react-tooltip": "^5.29.1",
    "redux": "^5.0.1",
    "redux-persist": "^6.0.0",
    "redux-thunk": "^3.1.0",
    "sql.js": "^1.10.3",
    "tauri-plugin-keyring-api": "^0.1.1",
    "tiny-secp256k1": "^2.2.3"
  },
  "overrides": {
    "@cashscript/utils": "0.13.0-next.3",
    "anymatch": {
      "picomatch": "^2.3.2"
    },
    "ws": "^8.21.0",
    "axios": "^1.18.0",
    "protobufjs": "^8.7.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.0.0",
    "@tauri-apps/cli": "^2.11.3",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "@vitest/coverage-v8": "^3.2.4",
    "@wdio/cli": "^9.29.1",
    "@wdio/local-runner": "^9.29.1",
    "@wdio/mocha-framework": "^9.29.1",
    "@wdio/spec-reporter": "^9.29.1",
    "autoprefixer": "^10.4.19",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^8.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "jsqr": "^1.4.0",
    "mocha": "^11.7.6",
    "patch-package": "^8.0.0",
    "postcss": "^8.5.15",
    "prettier": "^3.3.2",
    "tailwindcss": "^3.4.3",
    "tsx": "4.23.0",
    "typescript": "^5.2.2",
    "vite": "^8.0.16",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^3.2.4",
    "webdriverio": "^9.29.1"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
